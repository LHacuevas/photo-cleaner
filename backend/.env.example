# Copia este archivo como backend/.env y descomenta lo que quieras cambiar.
# Las variables de entorno reales tienen prioridad sobre este archivo.

# Dirección y puerto del backend. 0.0.0.0 lo expone en la red local:
# cualquiera en la red podría leer fotos de tu disco.
# PHOTO_CLEANER_HOST=127.0.0.1
# PHOTO_CLEANER_PORT=8000

# Base de datos (por defecto backend/photo_cleaner.db)
# PHOTO_CLEANER_DATABASE_URL=sqlite:///C:/ruta/a/photo_cleaner.db

# Orígenes del frontend permitidos, separados por comas.
# Vacío = cualquier puerto de localhost / 127.0.0.1.
# PHOTO_CLEANER_CORS_ORIGINS=http://localhost:3000

# Ejecutable de FFmpeg. Si no se indica, se busca en el PATH y en las
# carpetas de instalación habituales (winget, Program Files).
# PHOTO_CLEANER_FFMPEG=C:/ffmpeg/bin/ffmpeg.exe
